# Local-only demonstration credentials. Copy to .env; never use these outside localhost.
POSTGRES_USER=flash
POSTGRES_PASSWORD=flash_local_only
POSTGRES_DB=flash
DATABASE_URL=postgresql://flash:flash_local_only@127.0.0.1:5432/flash
REDIS_URL=redis://127.0.0.1:6379
API_PORT=3000
WORKER_PORT=3001
DATABASE_POOL_SIZE=10
DEPENDENCY_TIMEOUT_MS=2000
NODE_ENV=development
HTTP_PORT=8080
