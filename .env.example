# Local-only demonstration credentials. Copy to .env; never use these outside localhost.
POSTGRES_USER=flash
POSTGRES_PASSWORD=flash_local_only
POSTGRES_DB=flash
DATABASE_URL=postgresql://flash:flash_local_only@127.0.0.1:5432/flash
REDIS_URL=redis://127.0.0.1:6379
API_PORT=3000
WORKER_PORT=3001
DATABASE_POOL_SIZE=10
DEPENDENCY_TIMEOUT_MS=2000
NODE_ENV=development
HTTP_PORT=8080
ORDER_MAX_ATTEMPTS=5
ORDER_RETRY_BASE_MS=1000
ORDER_RETRY_MAX_MS=60000

# Optional exact origin for a separately hosted web client; omit for same-origin proxy.
WEB_ORIGIN=http://localhost:8080

ADMISSION_TIMEOUT_MS=3000
